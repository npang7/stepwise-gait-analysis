page {
  background: #eef3f7;
  color: #10202b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 56rpx;
}

.hero {
  background: #0f2f3f;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 34rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 18rpx 44rpx rgba(15, 47, 63, 0.16);
}

.hero.light {
  background: #ffffff;
  color: #10202b;
  border: 1rpx solid #d9e3ea;
  box-shadow: none;
}

.eyebrow {
  color: #79d0bd;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
  margin-bottom: 10rpx;
}

.hero.light .eyebrow {
  color: #147d70;
}

.title {
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 900;
  margin-bottom: 14rpx;
}

.section-title {
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #10202b;
  margin-bottom: 18rpx;
}

.subtitle {
  color: #5b6b77;
  font-size: 26rpx;
  line-height: 1.55;
}

.hero .subtitle {
  color: #d8e8ed;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #d9e3ea;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 22rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.button {
  display: block;
  box-sizing: border-box;
  width: 100%;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border: 0;
  border-radius: 12rpx;
  background: #1769aa;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

button::after {
  border: 0;
}

.button.secondary {
  background: #e7f1fb;
  color: #12507f;
}

.button.quiet {
  background: #eff4f6;
  color: #364b58;
}

.button:active,
.tap:active {
  opacity: 0.72;
}

.nav-list {
  margin-top: 20rpx;
}

.nav-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid #d9e3ea;
  border-radius: 14rpx;
  background: #ffffff;
}

.nav-main {
  font-size: 30rpx;
  font-weight: 800;
  color: #10202b;
}

.nav-sub {
  display: block;
  margin-top: 4rpx;
  color: #6a7a86;
  font-size: 23rpx;
  line-height: 1.35;
}

.chevron {
  color: #8aa0ad;
  font-size: 34rpx;
  margin-left: 18rpx;
}

.metric-grid {
  display: flex;
  flex-wrap: wrap;
  margin-left: -10rpx;
  margin-right: -10rpx;
}

.metric {
  box-sizing: border-box;
  width: calc(50% - 20rpx);
  min-height: 120rpx;
  margin: 10rpx;
  border: 1rpx solid #d9e3ea;
  border-radius: 14rpx;
  padding: 18rpx;
  background: #fbfdff;
}

.metric.full {
  width: calc(100% - 20rpx);
}

.metric-label {
  display: block;
  color: #6b7b86;
  font-size: 23rpx;
  line-height: 1.3;
}

.metric-value {
  display: block;
  color: #10202b;
  font-size: 31rpx;
  line-height: 1.22;
  font-weight: 900;
  margin-top: 8rpx;
  word-break: break-word;
}

.small {
  color: #667782;
  font-size: 24rpx;
  line-height: 1.55;
}

.badge {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #e6f6f1;
  color: #0f766e;
  font-weight: 800;
  font-size: 23rpx;
  line-height: 1.2;
}

.badge.warn {
  background: #fff3d6;
  color: #9a5b00;
}

.divider {
  height: 1rpx;
  background: #d9e3ea;
  margin: 22rpx 0;
}

.file-box {
  border: 1rpx solid #d9e3ea;
  border-radius: 14rpx;
  padding: 22rpx;
  background: #fbfdff;
  margin-bottom: 16rpx;
}

.file-status {
  display: inline-block;
  margin-top: 10rpx;
  color: #147d70;
  font-size: 23rpx;
  font-weight: 800;
}

.pill {
  display: inline-block;
  margin: 0 10rpx 10rpx 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #edf6f4;
  color: #147d70;
  font-size: 22rpx;
  font-weight: 800;
}

.timeline-item {
  position: relative;
  padding-left: 38rpx;
  margin-bottom: 24rpx;
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: 2rpx;
  top: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #147d70;
}

.timeline-item::after {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 34rpx;
  bottom: -12rpx;
  width: 2rpx;
  background: #d9e3ea;
}

.timeline-item.last::after {
  display: none;
}
